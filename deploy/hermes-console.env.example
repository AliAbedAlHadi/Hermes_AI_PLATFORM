# Federation Console settings — copy this file and fill in your own values.
#
# On the server (Oracle):   sudo cp hermes-console.env.example /etc/hermes-console.env
#                           sudo nano /etc/hermes-console.env
#                           sudo chmod 600 /etc/hermes-console.env
#                           sudo systemctl restart hermes-console
#
# On the PC (local runs):   copy to  Documents\Hermes\console\.env
#
# Never commit the filled file to Git, never share it in chat.

# Owner sign-in: on first start the console prints a one-time setup code; open /login, enter it and choose the owner password. Only a salted hash is stored (HERMES_HOME/federation/owner.json).
# Read the setup code with: journalctl -u hermes-console | grep 'setup code'

# Where the console listens. Keep 127.0.0.1 and publish through Cloudflare Tunnel.
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=8765

# Optional: Hermes home if it is not the default (~/.hermes on Linux, %LOCALAPPDATA%\hermes on Windows)
# HERMES_HOME=/home/ubuntu/.hermes
